# 프로덕션 .env 예시 — beautalk.site. 서버에서 backend/.env 로 복사해 실제 값 채운다.
# (.env 자체는 git 제외. 이 example만 커밋)

# Django
DJANGO_SECRET_KEY=<새로 생성: python -c "import secrets;print(secrets.token_urlsafe(50))">
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=beautalk.site,www.beautalk.site

# 도메인 (nginx가 /api 프록시하므로 프론트·백 동일 도메인)
FRONTEND_URL=https://beautalk.site
BACKEND_URL=https://beautalk.site
CORS_ALLOWED_ORIGINS=https://beautalk.site
CSRF_TRUSTED_ORIGINS=https://beautalk.site

# DB (compose의 db 서비스)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=beautalk
DB_USER=beautalk
DB_PASSWORD=<강한 비밀번호>
DB_HOST=db
DB_PORT=5432

# OAuth — 배포 redirect_uri를 카카오/구글 개발자 콘솔에도 반드시 등록
#   https://beautalk.site/api/v1/auth/kakao/callback/
#   https://beautalk.site/api/v1/auth/google/callback/
KAKAO_CLIENT_ID=...
KAKAO_CLIENT_SECRET=...
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# GMS (LLM·임베딩)
GMS_API_KEY=...
GMS_API_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1/chat/completions
GMS_MODEL=gpt-4o
GMS_REASONING_EFFORT=low
GMS_EMBED_MODEL=text-embedding-3-small

# (선택) 날씨 API — openweathermap.org 무료 키
# WEATHER_API_KEY=...

# (선택) LangSmith 관측
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=...
# LANGSMITH_PROJECT=beautalk

# Beautalk 백엔드 환경변수 예시
# 실제 값을 채워 backend/.env 로 복사하세요. (.env 는 git 에 커밋되지 않습니다)

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False                       # 운영은 False (기본값 False, fail-safe)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1 # 운영 시 도메인 추가 (예: beautalk.site)

# --- 소셜 로그인 (OAuth) ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 생성형 AI (GMS / OpenAI 호환) ---
GMS_API_KEY=
GMS_API_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1/chat/completions
GMS_MODEL=gpt-5-nano
GMS_REASONING_EFFORT=low                 # minimal|low|medium|high (낮출수록 빠름)
GMS_EMBED_MODEL=text-embedding-3-small   # RAG 임베딩 모델 (1536차원)

# --- 데이터베이스 (PostgreSQL + pgvector) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=beautalk
DB_USER=beautalk
DB_PASSWORD=beautalk
DB_HOST=localhost
DB_PORT=5432

# --- (선택) 날씨 API: 설정 시 날씨 맥락이 챗봇 프롬프트에 자동 주입됩니다 ---
# https://openweathermap.org/api 에서 무료 계정 → API Keys 탭
# WEATHER_API_KEY=

# --- (선택) LLM 관측: 설정 시 LangSmith 추적 활성화 ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=beautalk

<mxfile host="app.diagrams.net" type="device">
  <diagram name="하이브리드 추천 플로우" id="flow-1">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="하이브리드 추천 — &quot;하드 조건은 SQL, 부드러운 취향은 AI&quot;" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#3E4A2E;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="34" as="geometry" />
        </mxCell>

        <mxCell id="start" value="① 대화로 조건 수집&#10;제품군 · 제형 · 가격대 · 피부 고민" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0E4;strokeColor=#7E8B6D;fontColor=#33402A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="80" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="extract" value="② 제약 추출 (규칙 기반)&#10;발화 → {제형, 가격, 카테고리}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0E4;strokeColor=#7E8B6D;fontColor=#33402A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="180" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="sql" value="③ SQL 필터 (가격·제형·카테고리)&#10;조건 위반 제품을 후보에서 통째로 제외" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8D2;strokeColor=#5E7048;fontColor=#2E3A1E;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="280" width="280" height="64" as="geometry" />
        </mxCell>

        <mxCell id="decide" value="후보 ≥ 3 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FBF3D9;strokeColor=#C9A227;fontColor=#5a4a1a;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="330" y="384" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="relax" value="단계적 완화&#10;가격 ±1만원 → 제형 → 카테고리&#10;+ '무엇을 풀었는지' 배너 표기" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E7EC;strokeColor=#B98AA0;fontColor=#5A3A48;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="392" width="220" height="74" as="geometry" />
        </mxCell>

        <mxCell id="rank" value="④ 임베딩 코사인 정렬 (RAG)&#10;대화와 가장 비슷한 후보 순으로 — '도서관 사서'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE8D2;strokeColor=#5E7048;fontColor=#2E3A1E;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="514" width="300" height="64" as="geometry" />
        </mxCell>

        <mxCell id="llm" value="⑤ LLM이 후보 중 3개 선택 + 추천 이유 작성&#10;(위반 제품은 이미 ③에서 사라져 볼 수조차 없음)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0E4;strokeColor=#7E8B6D;fontColor=#33402A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="270" y="614" width="300" height="64" as="geometry" />
        </mxCell>

        <mxCell id="verify" value="⑥ 고른 id를 DB로 재검증 (환각 제거)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0E4;strokeColor=#7E8B6D;fontColor=#33402A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="714" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="result" value="추천 3개 + 이유 + ✓/✗ 충족 배지" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3E4A2E;strokeColor=#3E4A2E;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="804" width="280" height="56" as="geometry" />
        </mxCell>

        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B6B5A;endArrow=classic;" edge="1" parent="1" source="start" target="extract"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B6B5A;endArrow=classic;" edge="1" parent="1" source="extract" target="sql"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B6B5A;endArrow=classic;" edge="1" parent="1" source="sql" target="decide"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B98AA0;endArrow=classic;fontColor=#7a4a5a;fontSize=11;" edge="1" parent="1" source="decide" target="relax"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5E7048;endArrow=classic;fontColor=#3E4A2E;fontSize=11;" edge="1" parent="1" source="decide" target="rank"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B98AA0;endArrow=classic;" edge="1" parent="1" source="relax" target="rank"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B6B5A;endArrow=classic;" edge="1" parent="1" source="rank" target="llm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B6B5A;endArrow=classic;" edge="1" parent="1" source="llm" target="verify"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B6B5A;endArrow=classic;" edge="1" parent="1" source="verify" target="result"><mxGeometry relative="1" as="geometry" /></mxCell>

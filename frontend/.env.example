# Beautalk 프론트엔드 환경변수 예시
# 값을 채워 frontend/.env (개발) 또는 frontend/.env.production (운영) 로 복사하세요.
# Vite 는 VITE_ 접두사 변수만 빌드에 노출합니다. (시크릿은 절대 넣지 말 것)

# API 베이스 URL — 미설정 시 로컬 기본(http://localhost:8000/api/v1) 사용
VITE_API_BASE=http://localhost:8000/api/v1
# 운영 예시: VITE_API_BASE=https://beautalk.site/api/v1

# 루트 프로덕션 .env 예시 — docker-compose.prod.yml 의 db 서비스 environment(${DB_NAME} 등)
# 변수치환용. docker compose는 이 값을 "컴포즈 파일과 같은 디렉터리의 .env"에서만 읽는다
# (backend/.env 의 env_file 지시자는 backend 컨테이너 내부 전용이라 여기엔 적용 안 됨).
# → EC2에서 docker-compose.prod.yml 옆에 .env 로 복사해 값 채울 것.
# (backend/.env 의 DB_NAME/DB_USER/DB_PASSWORD 와 반드시 동일한 값으로 맞춘다.)

DB_NAME=beautalk
DB_USER=beautalk
DB_PASSWORD=<강한 비밀번호 — backend/.env 와 동일하게>
